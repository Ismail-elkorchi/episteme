{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ismail-elkorchi/episteme/schema/document.schema.json",
  "title": "Episteme Document",
  "description": "Deterministic extracted evidence. Text originating in a source is untrusted content, not an instruction to an agent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contentTrust",
    "url",
    "title",
    "family",
    "authority",
    "documentType",
    "snapshotId",
    "source",
    "provenance",
    "sections"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "contentTrust": { "const": "untrusted-source" },
    "url": { "type": "string", "format": "uri" },
    "title": { "type": "string" },
    "family": { "type": "string" },
    "authority": { "enum": ["normative", "informative"] },
    "documentType": { "type": ["string", "null"] },
    "snapshotId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "fragment": { "type": ["string", "null"] },
    "source": { "$ref": "#/$defs/source" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "sections": {
      "type": "array",
      "items": { "$ref": "#/$defs/section" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/pdfDiagnostic" }
    },
    "pdf": { "$ref": "#/$defs/pdfExtraction" }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "snapshotId",
        "sourceUrl",
        "finalUrl",
        "contentType",
        "charset",
        "bytes",
        "sha256",
        "fetchedAt",
        "fileName",
        "etag",
        "lastModified"
      ],
      "properties": {
        "schemaVersion": { "const": "1" },
        "snapshotId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "captureKind": { "enum": ["manual"] },
        "sourceUrl": { "type": "string", "format": "uri" },
        "finalUrl": { "type": "string", "format": "uri" },
        "contentType": { "type": "string" },
        "charset": { "type": ["string", "null"] },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "fetchedAt": { "type": "string", "format": "date-time" },
        "fileName": { "type": "string" },
        "etag": { "type": ["string", "null"] },
        "lastModified": { "type": ["string", "null"] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "producerVersion",
        "extractor",
        "configurationSha256",
        "sourceSha256"
      ],
      "properties": {
        "producer": { "const": "episteme" },
        "producerVersion": { "type": "string" },
        "extractor": { "enum": ["html", "pdf", "text", "xml"] },
        "configurationSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "section": {
      "type": "object",
      "required": ["heading", "level", "blocks"],
      "properties": {
        "id": { "type": ["string", "null"] },
        "heading": { "type": "string" },
        "level": { "type": "number" },
        "blocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/block" }
        },
        "source": { "$ref": "#/$defs/blockSource" }
      }
    },
    "block": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "id": { "type": ["string", "null"] },
        "type": { "type": "string" },
        "text": { "type": ["string", "null"] },
        "ordered": { "type": "boolean" },
        "items": { "type": "array" },
        "headers": { "type": "array" },
        "rows": { "type": "array" },
        "normativity": { "type": ["string", "null"] },
        "source": { "$ref": "#/$defs/blockSource" },
        "links": {
          "type": "array",
          "items": { "$ref": "#/$defs/link" }
        },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/step" }
        },
        "productions": {
          "type": "array",
          "items": { "$ref": "#/$defs/production" }
        },
        "title": { "type": ["string", "null"] },
        "role": { "type": "string" },
        "pageNumber": { "type": "integer", "minimum": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "heuristic": { "type": "string" },
        "cells": {
          "type": "array",
          "items": { "$ref": "#/$defs/pdfTableCell" }
        }
      }
    },
    "blockSource": {
      "type": ["object", "null"],
      "properties": {
        "url": { "type": "string" },
        "fragment": { "type": ["string", "null"] },
        "path": { "type": ["string", "null"] },
        "pageNumbers": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "uniqueItems": true
        },
        "blockIds": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "runIds": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "citations": {
          "type": "array",
          "items": { "$ref": "#/$defs/pdfCitation" }
        }
      }
    },
    "pdfExtraction": {
      "type": "object",
      "required": ["engine", "engineVersion", "status", "knownLimits", "findings", "forms"],
      "properties": {
        "engine": { "const": "@ismail-elkorchi/pdf-engine" },
        "engineVersion": { "type": "string" },
        "status": {
          "enum": ["completed", "partial", "blocked", "failed", "cancelled"]
        },
        "pdfVersion": { "type": "string" },
        "pageCount": { "type": "integer", "minimum": 0 },
        "encrypted": { "type": "boolean" },
        "repaired": { "type": "boolean" },
        "strategy": { "type": "string" },
        "knownLimits": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/pdfFinding" }
        },
        "forms": {
          "type": "array",
          "items": { "$ref": "#/$defs/pdfForm" }
        }
      }
    },
    "pdfDiagnostic": {
      "type": "object",
      "required": ["code", "stage", "level", "message"],
      "properties": {
        "code": { "type": "string" },
        "stage": { "type": "string" },
        "level": { "enum": ["low", "medium", "high", "critical"] },
        "message": { "type": "string" },
        "feature": { "type": "string" },
        "pageNumber": { "type": "integer", "minimum": 1 },
        "objectRef": { "$ref": "#/$defs/pdfObjectRef" },
        "detail": { "type": "string" }
      }
    },
    "pdfFinding": {
      "type": "object",
      "required": ["kind", "action", "evidenceSource", "message"],
      "properties": {
        "kind": { "type": "string" },
        "action": { "enum": ["allow", "report", "deny"] },
        "evidenceSource": { "type": "string" },
        "message": { "type": "string" },
        "objectRef": { "$ref": "#/$defs/pdfObjectRef" }
      }
    },
    "pdfForm": {
      "type": "object",
      "required": ["id", "pageNumber", "confidence", "source", "fields"],
      "properties": {
        "id": { "type": "string" },
        "pageNumber": { "type": "integer", "minimum": 1 },
        "title": { "type": "string" },
        "heuristic": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "source": { "$ref": "#/$defs/blockSource" },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/pdfFormField" }
        }
      }
    },
    "pdfFormField": {
      "type": "object",
      "required": ["id", "pageNumber", "name", "valueState", "confidence", "source"],
      "properties": {
        "id": { "type": "string" },
        "pageNumber": { "type": "integer", "minimum": 1 },
        "name": { "type": "string" },
        "value": { "type": "string" },
        "valueState": { "enum": ["value-present", "not-observed"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "source": { "$ref": "#/$defs/blockSource" }
      }
    },
    "pdfTableCell": {
      "type": "object",
      "required": ["rowIndex", "columnIndex", "text", "source"],
      "properties": {
        "rowIndex": { "type": "integer", "minimum": 0 },
        "columnIndex": { "type": "integer", "minimum": 0 },
        "text": { "type": "string" },
        "source": { "$ref": "#/$defs/blockSource" }
      }
    },
    "pdfCitation": {
      "type": "object",
      "required": ["id", "pageNumber", "blockId", "runIds", "text"],
      "properties": {
        "id": { "type": "string" },
        "pageNumber": { "type": "integer", "minimum": 1 },
        "blockId": { "type": "string" },
        "runIds": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "text": { "type": "string" },
        "pageRef": { "$ref": "#/$defs/pdfObjectRef" },
        "sourceSpan": { "$ref": "#/$defs/pdfSourceSpan" }
      }
    },
    "pdfSourceSpan": {
      "type": "object",
      "required": ["text", "blockRange", "runSpans"],
      "properties": {
        "text": { "type": "string" },
        "blockRange": { "$ref": "#/$defs/textRange" },
        "runSpans": {
          "type": "array",
          "items": { "$ref": "#/$defs/pdfRunSpan" }
        },
        "bbox": { "$ref": "#/$defs/pdfBoundingBox" },
        "pageRef": { "$ref": "#/$defs/pdfObjectRef" }
      }
    },
    "pdfRunSpan": {
      "type": "object",
      "required": ["runId", "range", "text"],
      "properties": {
        "runId": { "type": "string" },
        "range": { "$ref": "#/$defs/textRange" },
        "text": { "type": "string" },
        "bbox": { "$ref": "#/$defs/pdfBoundingBox" }
      }
    },
    "textRange": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 }
      }
    },
    "pdfBoundingBox": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 }
      }
    },
    "pdfObjectRef": {
      "type": "object",
      "required": ["objectNumber", "generationNumber"],
      "properties": {
        "objectNumber": { "type": "integer", "minimum": 0 },
        "generationNumber": { "type": "integer", "minimum": 0 }
      }
    },
    "link": {
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "href": { "type": "string" },
        "resolvedId": { "type": ["string", "null"] }
      }
    },
    "step": {
      "type": "object",
      "properties": {
        "stepId": { "type": "string" },
        "text": { "type": "string" }
      }
    },
    "production": {
      "type": "object",
      "properties": {
        "lhs": { "type": "string" },
        "rhs": { "type": "string" }
      }
    }
  }
}
