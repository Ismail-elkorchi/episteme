{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ismail-elkorchi/episteme/schema/cli-envelope.schema.json",
  "title": "Episteme CLI Envelope",
  "description": "The final result object emitted when Episteme is invoked with --json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "ok", "command", "data", "warnings", "error", "meta"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "ok": { "type": "boolean" },
    "command": { "type": ["string", "null"] },
    "data": { "type": ["object", "null"] },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "url": { "type": "string" },
          "snapshotId": { "type": "string" }
        }
      }
    },
    "error": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable", "details"],
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" },
            "retryable": { "type": "boolean" },
            "details": { "type": ["object", "null"] },
            "debug": {
              "type": "object",
              "additionalProperties": false,
              "required": ["causes", "issueUrl"],
              "properties": {
                "causes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name", "message", "stack"],
                    "properties": {
                      "name": { "type": "string" },
                      "message": { "type": "string" },
                      "stack": { "type": ["string", "null"] }
                    }
                  }
                },
                "issueUrl": { "type": "string", "format": "uri" }
              }
            }
          }
        }
      ]
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epistemeVersion"],
      "properties": {
        "epistemeVersion": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "ok": { "const": true } }, "required": ["ok"] },
      "then": {
        "properties": {
          "data": { "type": "object" },
          "error": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "ok": { "const": false } }, "required": ["ok"] },
      "then": {
        "properties": {
          "data": { "type": "null" },
          "error": { "type": "object" }
        }
      }
    }
  ]
}
