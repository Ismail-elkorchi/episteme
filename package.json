{
  "name": "episteme",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Deterministic, agent-first extraction of attributable evidence.",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ismail-elkorchi/episteme.git"
  },
  "bugs": {
    "url": "https://github.com/Ismail-elkorchi/episteme/issues"
  },
  "homepage": "https://github.com/Ismail-elkorchi/episteme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "schema",
    "README.md",
    "package.json"
  ],
  "bin": {
    "episteme": "src/cli.js"
  },
  "scripts": {
    "snapshot": "node src/cli.js snapshot",
    "extract": "node src/cli.js extract",
    "chunk": "node src/cli.js chunk",
    "index": "node src/cli.js index",
    "diff": "node src/cli.js diff",
    "query": "node src/cli.js query",
    "pipeline": "node src/cli.js pipeline",
    "extract:example": "node src/cli.js extract --manifest examples/manifest.json --out out",
    "manual-ingest": "node src/cli.js manual-ingest",
    "test:xml": "node --test tests/xml-extractor.test.js",
    "test:html-engine": "node --test tests/html-engine.contract.test.js",
    "test:html": "node --test tests/html-extractor.test.js",
    "test:html:golden": "node --test tests/html-golden.test.js",
    "test:pdf": "node --test tests/pdf-extractor.test.js",
    "test:chunk": "node --test tests/chunk-path-safety.test.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**/*.js' --test-coverage-lines=70 --test-coverage-functions=70 --test-coverage-branches=60",
    "check": "npm run test:coverage",
    "check:audit": "npm audit --audit-level=high",
    "check:deno": "deno test --no-check --allow-read --allow-write --allow-net --allow-env --node-modules-dir=manual tests",
    "package:check": "node scripts/verify-package.mjs",
    "package:check:jsr": "deno publish --dry-run",
    "check:ci": "npm run check && npm run check:audit && npm run package:check"
  },
  "dependencies": {
    "@ismail-elkorchi/css-parser": "^0.2.0",
    "@ismail-elkorchi/html-parser": "^0.2.1",
    "@ismail-elkorchi/http-client": "0.1.1",
    "@ismail-elkorchi/pdf-engine": "0.1.0",
    "@ismail-elkorchi/xml-parser": "^0.2.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.13.3",
    "ajv": "^8.20.0"
  }
}
