{
  "$schema": "https://jsr.io/schema/config-file.v1.json",
  "name": "@ismail-elkorchi/episteme",
  "version": "0.1.0",
  "exports": {
    "./cli": "./src/cli.js"
  },
  "imports": {
    "@ismail-elkorchi/http-client": "jsr:@ismail-elkorchi/http-client@0.1.1"
  },
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": [
      "jsr:@ismail-elkorchi/http-client"
    ]
  },
  "publish": {
    "include": [
      "LICENSE",
      "README.md",
      "package.json",
      "schema/**/*.json",
      "src/**/*.d.ts",
      "src/**/*.js"
    ]
  }
}
